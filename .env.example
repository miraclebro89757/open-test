# Open-Test Environment Variables
# Copy this to .env and fill in your values

# Legacy fallback used only when opentest.config.json has no real key.
OPENAI_API_KEY=your_openai_api_key_here

# Preferred LLM settings. A project or user config file outranks these.
# OPENTEST_PROFILE=free-openrouter
# OPENTEST_PROVIDER=openrouter
# OPENTEST_BASE_URL=https://openrouter.ai/api/v1
# OPENTEST_MODEL=deepseek/deepseek-r1:free
# OPENTEST_API_KEY=

# Database
POSTGRES_DB=wharttest
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
DATABASE_URL=postgres://admin:password@postgres:5432/wharttest

# Redis
REDIS_URL=redis://redis:6379

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# API
API_URL=http://localhost:8000

# Frontend
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000
