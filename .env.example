# Open-Test environment variables
# Copy to .env and fill in. Precedence: overrides > ./opentest.config.json >
# ~/.opentest/config.json > this file > built-in preset.

# --- LLM provider -------------------------------------------------------
# Prefer `npx open-test config`, which writes opentest.config.json.
# These variables are the fallback for headless setups.

# Legacy fallback, reached only when no preset matches.
OPENAI_API_KEY=

OPENTEST_PROFILE=
OPENTEST_PROVIDER=
OPENTEST_BASE_URL=
OPENTEST_MODEL=
OPENTEST_API_KEY=

# Point the agent at a config file other than ./opentest.config.json
OPENTEST_CONFIG=

# Override the working directory and ~/.opentest the agent sees
OPENTEST_CWD=
OPENTEST_HOME=

# --- Requirement graph (optional) ---------------------------------------
# Written by `npx open-test services up`. Set these to use an existing
# Neo4j instead of the bundled one. Without them the graph stays in graph/.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Defect trackers (optional) -----------------------------------------
# /defects reports what is missing rather than inventing bugs.

# Zentao
ZENTAO_BASE_URL=
ZENTAO_TOKEN=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_JQL=